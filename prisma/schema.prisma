// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]

  transactions  Transaction[]
  goals         Goal[]
  limits        Limit[]
  creditCard    CreditCard?
  avisos        Aviso[]
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AvisoTipo {
  AVISO
  VENCIMENTO
  COBRANCA
}

enum Recorrencia {
  NENHUMA
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
}

model Aviso {
  id          String      @id @default(cuid())
  nome        String
  descricao   String?
  valor       Float       @default(0)
  data        DateTime
  tipo        AvisoTipo   @default(AVISO)
  recorrencia Recorrencia @default(NENHUMA)
  pago        Boolean     @default(false)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  title       String
  description String?
  value       Float
  color         String   @default("#ffffffff")
  type        TransactionType @default(EXPENSE) // INCOME ou EXPENSE
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Goal {
  id            String   @id @default(cuid())
  title         String
  targetAmount  Float    // Valor desejado
  currentAmount Float    @default(0) // Quanto já tem
  deadline      DateTime?
  color         String   @default("#ffffffff")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Limit {
  id            String   @id @default(cuid())
  title         String
  limitAmount   Float    // Valor teto
  currentSpent  Float    @default(0) // O que já gastou nesse limite
  color         String   @default("#ffffffff")
  createdAt     DateTime @default(now())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditCard {
  id            String   @id @default(cuid())
  currentInvoice Float    @default(0) // Valor da fatura atual
  limit         Float    // Limite total do cartão
  brand         String?  @default("VISA") // Para o estilo que vimos na dash
  
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}